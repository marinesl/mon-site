{% set portfolioRoute = baseRoute ~ '_portfolio' %}

<header>

    <div>
        <a href="{{ path('home') }}" title="Accueil">
            <img src="{{ asset('logo/logo' ~ isOrangeImg ~ '.svg') }}" alt="Logo" id="logo">
        </a>
    </div>

    <div class="link">
        {# Mobile + Tablette #}
        <button class="burger">
            <svg class="is-open" xmlns="http://www.w3.org/2000/svg" width="27" height="17" stroke="#41B591" fill="none" stroke-linecap="round" stroke-width="2" xmlns:v="https://vecta.io/nano">
                <path d="M1 1.5h25m-25 7h25m-25 7h25"></path>
            </svg>            
            <svg class="is-close" xmlns="http://www.w3.org/2000/svg" width="21" height="21" stroke="#41B591" fill="none" stroke-linecap="round" stroke-width="2" xmlns:v="https://vecta.io/nano">
                <path d="M1.662 1.662l17.678 17.678"></path>
                <path d="M1.662 19.339L19.339 1.662"></path>
            </svg>        
        </button>

        <ul class="menu-mobile">
            <li>
                <a href="{{ path(baseRoute) }}" title="Présentation"
                class="nav-link{% if currentRoute == baseRoute %} active{% endif %}"
            >
                Présentation</a>
            </li>

            {% if baseRoute == 'dev' %}
                <li>
                    <a href="{{ path(portfolioRoute) }}"
                        class="nav-link {% if currentRoute == portfolioRoute %} active{% endif %}"
                    >
                        Portfolio</a>
                </li>
            {% endif %}

            <li><a href="{{ path(baseRoute) }}#contact" class="nav-link">Contact</a></li>

            <li class="nav-socials">
                {{ include('layouts/menu-socials.html.twig', { color: '-vert' }) }}
            </li>
        </ul>

        {# Desktop #}
        <div class="menu-desktop">
            <div>
                <a href="{{ path(baseRoute) }}" title="Présentation"
                    {% if currentRoute == baseRoute %}class="active"{% endif %}
                >
                    Présentation</a>
            </div>

            {% if baseRoute == 'dev' %}
                <div>
                    <a href="{{ path(portfolioRoute) }}"
                        {% if currentRoute == portfolioRoute %}class="active"{% endif %}
                    >
                        Portfolio</a>
                </div>
            {% endif %}

            <div>
                <a href="{{ path(baseRoute) }}#contact">Contact</a>
            </div>

            <div id="menu-rs">
                {{ include('layouts/menu-socials.html.twig', { color: '' }) }}
            </div>
        </div>
    </div>

</header>

{% if currentRoute == baseRoute %}
    <img src="{{ asset('forme/blob-header-home' ~ isOrangeImg ~ '.svg') }}" alt="Tâche verte en fond" id="header-forme">
{% else %}
    <img src="{{ asset('forme/blob-header' ~ isOrangeImg ~ '.svg') }}" alt="Tâche verte en fond" id="header-forme">
{% endif %}
