                <p>ITIC PARIS<br><span>Paris, France</span></p>
            </div>
            <div class="parcours p2">
                <p class="{{ isOrange }}">Licence Pro. Systèmes<br>Informatiques et&nbsp;Logiciel</p>
                <p class="{{ isOrange }}">de 2015 à 2016</p>
                <p>CFA UPMC<br><span>Paris, France</span></p>
            </div>
            <div class="parcours p3">
                <p class="{{ isOrange }}">Master<br>Développement Web</p>
                <p class="{{ isOrange }}">de 2017 à 2019</p>
                <p>ECV Digital<br><span>Paris, France</span></p>
            </div>
            {% block formation %}{% endblock %}
        </div>
    </div>
</div>