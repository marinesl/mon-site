<div class="row" id="contact">

    <div>
        <div id="contact-intro">
            <h2>Contact</h2>
            <p>Pour échanger avec moi, n'hésitez pas à&nbsp;me&nbsp;contacter&nbsp;!</p>
        </div>
    </div>

    <div class="row">
        {{ form_start(form) }}

        <div class="fields">
            <div class="left">
                {{ form_row(form.prenom) }}
                {{ form_row(form.nom) }}
                {{ form_row(form.email) }}
                {{ form_row(form.telephone) }}
            </div>

            <div class="right" id="row-message">
                {{ form_row(form.message) }}
            </div>
        </div>

        {{ form_row(form.save) }}
        {{ form_end(form) }}
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('fail') %}
        <div class="alert alert-fail">
            {{ message }}
        </div>
    {% endfor %}

</div>