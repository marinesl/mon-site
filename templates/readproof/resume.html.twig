    {# Fun facts #}
    <div class="row" id="fun-facts">

        <div class="left">
            <h2 class="orange">Fun facts</h2>
            <p>Non, les développeurs ne&nbsp;passent pas leurs journées enfermés dans un&nbsp;sous-sol à&nbsp;coder en&nbsp;boucle. Personnellement, je&nbsp;ne&nbsp;rate aucun match du&nbsp;XV&nbsp;de&nbsp;France, je&nbsp;lis dans le&nbsp;métro, je&nbsp;ne&nbsp;passe pas un&nbsp;été sans prendre l'avion, et&nbsp;j'adore retrouver mes&nbsp;amis dans un&nbsp;bar, et&nbsp;les&nbsp;photographier, bien sûr.</p>
        </div>

        <div class="right">
            <div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-1_orange.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-1.svg') }}" alt="Deux passeports" class="fact">
                    <p><span>30 pays visités</span><br>dont la Thaïlande<br>et les Philippines</p>
                </div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-2_orange.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-2.svg') }}" alt="Un appareil photo et une lune" class="fact">
                    <p><span>Photographe passionnée</span><br>argentique et&nbsp;numérique</p>
                </div>
            </div>
            <div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-3_orange.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-3.svg') }}" alt="Un ballon de rugby" class="fact">
                    <p><span>Fan de rugby</span><br>supportrice<br>du&nbsp;XV de&nbsp;France</p>
                </div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-6_orange.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-6.svg') }}" alt="Deux livres empilés" class="fact">
                    <p><span>Lectrice passionnée</span><br>d’essais féministes<br>et de romans en anglais</p>
                </div>
            </div>
        </div>
    </div>
    
    {# Contact #}
    <div class="row" id="contact">

        <div>
            <div id="contact-intro">
                <h2>Contact</h2>
                <p>Si vous avez un&nbsp;ouvrage technique à&nbsp;faire relire, parlons-en&nbsp;!</p>
            </div>
        </div>


        <div class="row">
            {{ form_start(form) }}

            <div class="fields">
                <div class="left">
                    {{ form_row(form.prenom) }}
                    {{ form_row(form.nom) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.telephone) }}
                </div>

                <div class="right" id="row-message">
                    {{ form_row(form.message) }}
                </div>
            </div>

            {{ form_row(form.save) }}
            {{ form_end(form) }}
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('fail') %}
            <div class="alert alert-fail">
                {{ message }}
            </div>
        {% endfor %}
    </div>

{% endblock %}
