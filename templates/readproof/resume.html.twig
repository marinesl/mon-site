            </div>
        </div>

        <div class="row" id="scolaire-parcours">
            <hr>

            <div>
                <div class="parcours p1">
                    <div>
                        <p class="orange">BTS Services informatiques<br>aux&nbsp;organisations</p>
                        <p class="orange">de 2013 à 2015</p>
                        <p>ITIC PARIS<br><span>Paris, France</span></p>
                    </div>
                </div>
                <div class="parcours p2">
                    <div>
                        <p class="orange">Licence Pro. Systèmes<br>Informatiques et&nbsp;Logiciel</p>
                        <p class="orange">de 2015 à 2016</p>
                        <p>CFA UPMC<br><span>Paris, France</span></p>
