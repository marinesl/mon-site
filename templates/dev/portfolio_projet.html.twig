    {% extends 'base_site.html.twig' %}

{% block title %}{{ project['title'] }}{% endblock %}

{% block meta_title %}Marine LANCELIN - {{ project['title'] }}{% endblock %}

{% block meta_content %}Découvrez mon projet : {{ project['title'] }}{% endblock %}

{% block meta_img %}{{ asset('projet_couverture/'~ project['token'] ~'.png') }}{% endblock %}

{% block body_id %}dev{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/project.css') }}">
{% endblock %}


{% block body %}

    <div class="spacer-2"></div>

    <div class="row" id="retour">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <button class="btn"><a href="{{ path('dev_portfolio') }}"> <img src="{{ asset('picto/arrow-left.svg') }}" alt="Retour"> Portfolio</a></button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <h1>{{ project['title'] }}</h1>
        </div>
    </div>

    <div class="row" id="projet">
        <div class="col-lg-6 col-md-12 col-sm-12">
            <img src="{{ asset('projet_couverture/'~ project['token'] ~'.png') }}" alt="{{ project['title'] }}">
        </div>

        <div class="col-lg-6 col-md-12 col-sm-12">
            <div>{{ project['description']|raw }}</div>
            
            <div>
                {% for tag in project['tags'] %}
                    <div>{{ tag['string'] }}</div>
                {% endfor %}
            </div>

            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    {% if project['projectLink'] %}
                        <button class="btn"> <a href="{{ project['projectLink'] }}" title="Lien du projet" target="_blank"> <img src="{{ asset('picto/open-tab.svg') }}" alt="Ouverture d'un nouvel onglet"> Lien du projet</a></button>
                    {% endif %}

                    {% if project['githubLink'] %}
                        <button class="btn"> <a href="{{ project['githubLink'] }}" title="Lien du Github" target="_blank"> <img src="{{ asset('picto/github.svg') }}" alt="Github"> Github</a></button>
                    {% endif %}
                 </div>
            </div>
        </div>
    </div>

{% endblock %}
