{% extends 'base_site.html.twig' %}

{% block title %}Présentation{% endblock %}

{% block meta_title %}Marine LANCELIN - Développeur Symfony/PHP Freelance{% endblock %}

{% block meta_content %}Découvrez mon profil de Développeur Symfony/PHP Freelance{% endblock %}

{% block meta_img %}{{ asset('images/opengraph.png') }}{% endblock %}

{% block body_id %}dev{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/resume.css') }}">
{% endblock %}

{% block body %}

    {# Introduction #}
    {{ include('dev/resume_page/introduction.html.twig') }}

    {# A propos #}
    {{ include('dev/resume_page/a_propos.html.twig') }}


    {# Commentaires #}
    <div class="row" id="comments">

        <h2>Ils m'ont fait confiance</h2>

        <div>
            <ul>
                <li>
                    <span class="comment-text">Marine est une&nbsp;excellente développeuse, appliquée et&nbsp;rigoureuse. Elle&nbsp;accomplit ses&nbsp;missions avec brio et&nbsp;apporte son&nbsp;expertise et&nbsp;ses&nbsp;conseils sur l'évolution de&nbsp;nos&nbsp;outils. Je&nbsp;referai appel à&nbsp;elle sans hésiter pour d'autres projets.</span>
                    <span class="comment-author">Baptiste Le Bescond</span>
                </li>
                <li>
                    <span class="comment-text">Merci beaucoup pour cette&nbsp;semaine, cette&nbsp;formation était bien au-delà de&nbsp;mes&nbsp;attentes et&nbsp;toutes les&nbsp;notions vues concernant PHP étaient une&nbsp;très bonne introduction au&nbsp;code PHP dans WordPress.</span>
                    <span class="comment-author">Étudiant(e) à Simplon</span>
                </li>
                <li>
                    <span class="comment-text">Marine a su comprendre mon&nbsp;univers et&nbsp;développer au&nbsp;mieux le&nbsp;site vitrine de&nbsp;mon&nbsp;entreprise. Une&nbsp;communication fluide et&nbsp;efficace ont permis de&nbsp;faciliter nos&nbsp;échanges afin de&nbsp;suivre au&nbsp;mieux l'avancée du&nbsp;projet. Bravo Marine&nbsp;!</span>
                    <span class="comment-author">Atelier Boulette</span>
                </li>
                <li>
                    <span class="comment-text">Merci Marine pour ta&nbsp;contribution enrichissante dans le&nbsp;début de&nbsp;mon&nbsp;parcours professionnel. Ta&nbsp;formation WordPress m’a permis de&nbsp;découvrir un&nbsp;nouveau champ et&nbsp;de&nbsp;confirmer ma&nbsp;passion pour la&nbsp;programmation.</span>
                    <span class="comment-author">Étudiant(e) à Simplon</span>
                </li>
            </ul>
        </div>

    </div>

    <div class="spacer"></div>

    {# Compétences #}
    {{ include('dev/resume_page/competences.html.twig') }}

    {# Parcours scolaire #}
    {{ include('dev/resume_page/scolaire.html.twig') }}

    {# Parcours professionnel #}
    {{ include('dev/resume_page/pro.html.twig') }}

    {# Fun facts #}
    <div class="row" id="fun-facts">

        <div class="left">
            <h2>Fun facts</h2>
            <p>Non, les développeurs ne&nbsp;passent pas leurs journées enfermés dans un&nbsp;sous-sol à&nbsp;coder en&nbsp;boucle. Personnellement, je&nbsp;ne&nbsp;rate aucun match du&nbsp;XV&nbsp;de&nbsp;France, je&nbsp;lis dans le&nbsp;métro, je&nbsp;ne&nbsp;passe pas un&nbsp;été sans prendre l'avion, et&nbsp;j'adore retrouver mes&nbsp;amis dans un&nbsp;bar, et&nbsp;les&nbsp;photographier, bien sûr.</p>
        </div>

        <div class="right">
            <div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-1.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-1.svg') }}" alt="Deux passeports" class="fact">
                    <p><span>30 pays visités</span><br>dont la Thaïlande<br>et les Philippines</p>
                </div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-2.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-2.svg') }}" alt="Un appareil photo et une lune" class="fact">
                    <p><span>Photographe passionnée</span><br>argentique et&nbsp;numérique</p>
                </div>
            </div>
            <div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-3.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-3.svg') }}" alt="Un ballon de rugby" class="fact">
                    <p><span>Fan de rugby</span><br>supportrice<br>du&nbsp;XV de&nbsp;France</p>
                </div>
                <div>
                    <img src="{{ asset('forme/blob-fun-fact-6.svg') }}" alt="Forme verte" class="forme">
                    <img src="{{ asset('picto/fun-fact-6.svg') }}" alt="Deux livres empilés" class="fact">
                    <p><span>Lectrice passionnée</span><br>d’essais féministes<br>et de romans en anglais</p>
                </div>
            </div>
        </div>
    </div>
    
    {# Contact #}
    <div class="row" id="contact">

        <div>
            <div id="contact-intro">
                <h2>Contact</h2>
                <p>Si vous avez un&nbsp;projet PHP/Symfony en&nbsp;tête, parlons-en&nbsp;!</p>
            </div>
        </div>

        <div class="row">
            {{ form_start(form) }}

            <div class="fields">
                <div class="left">
                    {{ form_row(form.prenom) }}
                    {{ form_row(form.nom) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.telephone) }}
                </div>

                <div class="right" id="row-message">
                    {{ form_row(form.message) }}
                </div>
            </div>

            {{ form_row(form.save) }}
            {{ form_end(form) }}
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('fail') %}
            <div class="alert alert-fail">
                {{ message }}
            </div>
        {% endfor %}

    </div>

{% endblock %}
