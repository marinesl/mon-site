        <div class="row">
            {{ form_start(form) }}

            <div class="fields">
                <div class="left">
                    {{ form_row(form.prenom) }}
                    {{ form_row(form.nom) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.telephone) }}
                </div>

                <div class="right" id="row-message">
                    {{ form_row(form.message) }}
                </div>
            </div>

            {{ form_row(form.save) }}
            {{ form_end(form) }}
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('fail') %}
